# ─────────────────────────────────────────────────────────────
# Arca-api-Tordini — Variables de entorno
# Copia este archivo a `.env` y completá los valores para tu
# proyecto. Todos los valores tienen defaults razonables.
# ─────────────────────────────────────────────────────────────

# ── Entorno ARCA ─────────────────────────────────────────────
# Valores válidos: "homologacion" (default) o "produccion"
# Es INDEPENDIENTE de NODE_ENV. Por ejemplo, podés tener
# NODE_ENV=production + ARCA_ENV=homologacion para staging.
ARCA_ENV=homologacion

# ── Emisor (server standalone y docker compose) ─────────────
ARCA_CUIT=
ARCA_RAZON_SOCIAL=
ARCA_DOMICILIO=
ARCA_CONDICION_IVA=Responsable Inscripto
ARCA_INICIO_ACTIVIDADES=
ARCA_INGRESOS_BRUTOS=
ARCA_PTO_VTA_DEFAULT=1
# ARCA_DATOS_BANCARIOS=

# ── Directorio de certificados ───────────────────────────────
# Ruta absoluta a la carpeta que contiene las subcarpetas
# "homologacion" y "produccion" con cert.crt y private.key.
# En Docker, suele ser /app/certs o /usr/src/app/certs.
CERTS_DIR=./certs

# Carpeta donde se cachea el TA (default: la misma de los certs).
# Separarla permite montar los certs en solo lectura (Docker: /app/ta).
# ARCA_TA_DIR=./ta

# ── Archivos dentro de cada entorno ─────────────────────────
# Defaults mostrados — generalmente NO necesitas cambiarlos.
ARCA_CERT_FILE=cert.crt
ARCA_KEY_FILE=private.key
ARCA_TA_FILE=TA_wsfe.xml
ARCA_TRA_FILE=tra.xml
ARCA_CMS_FILE=cms.der

# ── Servicio de autenticación ───────────────────────────────
# "wsfe" para Factura Electrónica, "wsmtxca" para tique,
# etc. Ver manual ARCA.
ARCA_SERVICE=wsfe

# ── HTTP Server (solo si usás el server standalone) ─────────
ARCA_HTTP_PORT=3001
ARCA_HTTP_HOST=0.0.0.0

# ── Auth JWT (solo para los endpoints REST) ──────────────────
# Si está vacío, los endpoints /afip/* NO requieren JWT.
# En producción es obligatorio (el server no arranca sin él).
# Generalo con: openssl rand -hex 32 (mínimo 32 caracteres en producción)
ARCA_JWT_SECRET=
# Antigüedad máxima aceptada de un JWT (claim iat). Solo se aceptan tokens HS256.
ARCA_JWT_EXPIRES_IN=12h

# ── CORS (solo para server standalone) ──────────────────────
# Lista separada por comas. "*" para permitir todos (solo en desarrollo).
# En producción: el origen exacto del POS, ej. https://pos.example.com
ARCA_CORS_ORIGINS=*

# ── Rate limit ───────────────────────────────────────────────
# Reservado: el server standalone no aplica rate limit. Configuralo en el reverse proxy.
ARCA_RATE_LIMIT_WINDOW_MS=60000
ARCA_RATE_LIMIT_MAX=100

# ── Puppeteer (PDFs) ─────────────────────────────────────────
# Path explícito a Chrome/Chromium. Si está vacío, Puppeteer
# busca el Chromium que descargó automáticamente. En Docker,
# suele ser /usr/bin/google-chrome-stable.
ARCA_PUPPETEER_EXECUTABLE_PATH=
ARCA_PUPPETEER_CONCURRENCY=2
ARCA_PUPPETEER_MAX_USOS=100

# ── Templates HTML de PDF ───────────────────────────────────
# Rutas absolutas o relativas al cwd. Si están vacías, se
# usan los templates por defecto incluidos en el paquete.
ARCA_TEMPLATE_FACTURA=
ARCA_TEMPLATE_PRESUPUESTO=
ARCA_TEMPLATE_TICKET=

# Formato de las facturas: "a4" (default) o "ticket" (impresora térmica).
# Ancho del ticket en mm: 80 (default) o 58.
ARCA_PDF_FORMATO=a4
ARCA_PDF_TICKET_MM=80

# ── Contingencia CAEA ───────────────────────────────────────
# Punto de venta de tipo CAEA. Si está definido, cuando ARCA no responde
# se emite con el CAEA de la quincena y se informa cuando vuelve.
# ARCA_CAEA_PTO_VTA=

# ── Facturación ─────────────────────────────────────────────
# Importe desde el cual ARCA exige identificar al Consumidor Final
# (DNI/CUIL/CDI). RG 5700/2025: 10000000. 0 desactiva la validación.
ARCA_MONTO_MAX_CF=10000000

# ── Logging ─────────────────────────────────────────────────
# "silent" | "error" | "warn" | "info" | "debug"
ARCA_LOG_LEVEL=info
